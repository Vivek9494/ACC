# Dev: requests to /api are proxied to the NestJS API (see vite.config.ts).
API_PROXY_TARGET=http://localhost:3001

# Deployed builds: absolute API origin (must be in the API's CORS_ORIGINS).
# Netlify sets this in apps/web-admin/netlify.toml.
# VITE_API_URL=https://acc-api-production.up.railway.app
