# Dev: requests to /api are proxied to the NestJS API (see vite.config.ts).
API_PROXY_TARGET=http://localhost:3001

# Deployed builds: absolute API origin (must be in the API's CORS_ORIGINS).
# Netlify sets this in apps/web-admin/netlify.toml.
# VITE_API_URL=https://acc-api-production.up.railway.app

# Overlay app framed by the Overlay preview page. Defaults to http://localhost:5178
# in dev and https://acc-overlay.netlify.app in builds. Its /preview.html only
# allows framing from https://acc-admin.netlify.app (apps/scoring-overlay/netlify.toml).
# VITE_OVERLAY_URL=https://acc-overlay.netlify.app
