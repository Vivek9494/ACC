# Copy to .env before running the api: cp .env.example .env
# (.env is git-ignored; commit only this example.)

NODE_ENV=development
# 3000 is the conventional NestJS port; this repo defaults to 3001 to avoid
# clashing with other local services that commonly bind 3000.
# Bind address for the HTTP server. Use 0.0.0.0 so phones on the same Wi‑Fi can
# reach the API when testing with Expo Go (physical device).
HOST=0.0.0.0
PORT=3001

# PostgreSQL connection string.
# Matches docker/docker-compose.yml defaults (host port 5435, user/pass/db = acc).
DATABASE_URL=postgresql://acc:acc@localhost:5435/acc?schema=public

# Redis connection string.
# Matches docker/docker-compose.yml defaults (host port 6380).
REDIS_URL=redis://localhost:6380

# JWT signing secrets (min 16 chars). Use long random values in real envs, e.g.
#   openssl rand -hex 32
# Access and refresh MUST use different secrets.
JWT_ACCESS_SECRET=124271068dc0a8f50c24d18be41dc1be3646ee1caf0a28e08f785dd52eff3328
JWT_REFRESH_SECRET=c24bcbca54f0674bd5176b7fe9030396283b1b11690e4e3f47f0c3e13b4eec7a

# Access token lifetime (refresh idle timeout is fixed at 10 days per spec §3.2).
# 1h is comfortable for local dev; production typically uses a shorter value (e.g. 15m).
JWT_ACCESS_TTL=1h

# AWS S3 object storage (ca-central-1 — PIPEDA data residency).
# All profile photos, posters, logos, broadcast images, and skill videos use this bucket.
# Local dev: MinIO from docker-compose (port 9000). Create bucket `acc-media` in MinIO console.
# AWS_S3_BUCKET=acc-media
# AWS_REGION=ca-central-1
# AWS_S3_ENDPOINT=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio123456
# Admins can override the secret access key at runtime via Admin Settings (AWS Key); env is the fallback.

# Public base URL for dev fallback when S3 is not configured (serves uploads/ statically).

# PUBLIC_API_URL=http://192.168.2.11:3001
# PUBLIC_API_URL=http://localhost:3001

# Twilio SMS (optional). Leave unset in local dev — OTPs are logged to the API
# console instead of being sent. Set all three to send real SMS (§29).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Google Places / Geocoding API key (server-side proxy at GET /places/*).
# Enable "Places API (New)" and "Geocoding API" on the key; restrict by IP in production.
# Must start with "AIzaSy" (no extra characters before it).
# Admins can override at runtime via Admin Settings; this env value is the fallback when unset.
# Leave unset in local dev — location autocomplete returns PLACES_UNAVAILABLE.
# GOOGLE_PLACES_KEY=AIzaSy...

# Firebase Cloud Messaging service account (optional — §29 push). Leave unset in
# local dev: pushes are logged to the API console instead of being sent. Set all
# three (from the Firebase service-account JSON) to deliver real push.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Wrap in double quotes; keep the literal \n escapes from the JSON private_key.
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
