generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// First-class platform roles (spec §2). Scorer (per-match grant) and Guest
/// (unauthenticated) are intentionally not stored here. ADMIN and CLUB_MANAGER
/// are platform-global and live on `User.role`; the others can also appear as
/// scoped grants in `RoleAssignment`.
enum UserRole {
  ADMIN
  CLUB_MANAGER
  CENTER_SEVAK
  CAPTAIN
  VICE_CAPTAIN
  MANAGER
  PLAYER
}

enum JerseySize {
  XS
  S
  M
  L
  XL
  XXL
}

/// Resolved tournament type (spec §1, §1.1).
enum TournamentType {
  ACC
  APL
  CENTER
}

/// Ball type drives ACC vs Tennis-ball rules (spec §1.1, §6.1).
enum BallType {
  LEATHER
  TENNIS
}

/// Tournament lifecycle states (spec §5.1).
enum TournamentState {
  NEW
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  TEAMS_FINALIZED
  FIXTURE_PUBLISHED
  LIVE
  KNOCKOUT
  COMPLETED
}

/// Supported tournament formats (spec §24).
enum TournamentFormat {
  LEAGUE_SINGLE_ROUND_ROBIN
  LEAGUE_DOUBLE_ROUND_ROBIN
  KNOCKOUT_SINGLE_ELIMINATION
  KNOCKOUT_SEEDED
  KNOCKOUT_DOUBLE_ELIMINATION
  GROUP_STAGE_KNOCKOUT
  SWISS
  LADDER_CHALLENGE
  POOL
}

/// Coarse fixture mode chosen at Schedule Matches (mobile modal). Not the same as
/// {@link TournamentFormat} set at tournament creation (§24).
enum MatchSchedulingFormat {
  ROUND_ROBIN
  GROUP_STAGE_KNOCKOUT
  MANUAL
}

/// Match states (spec §5.2).
enum MatchState {
  SCHEDULED
  PLAYING_XI_LOCKED
  TOSS_COMPLETED
  LIVE
  DELAYED
  RAIN_INTERRUPTED
  CANCELLED
  NO_RESULT
  COMPLETED
  SCORECARD_LOCKED
}

/** Knockout / league stage of a fixture (§11 manual match setup). */
enum MatchType {
  LEAGUE_MATCH
  PRE_QUARTER_FINAL
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
  SUPER_LEAGUE
  QUALIFIER_1
  QUALIFIER_2
  ELIMINATOR
  SUPER_EIGHT
}

/// Identifies one of a match's two sides without a hard FK (the away side may
/// be an external, non-system team in ACC — spec §9.5).
enum MatchSide {
  TEAM_A
  TEAM_B
}

/// Role of a player within a locked matchday squad (spec §9.7, §8).
/// A suspended player may be in PLAYING_XI but never a SUBSTITUTE (§9.7).
/// IMPACT_CANDIDATE rows exist only when the tournament enables Impact Player;
/// exactly one candidate may be flagged the active 12th at lock time (§31 #4(a)).
enum MatchSquadRole {
  PLAYING_XI
  SUBSTITUTE
  IMPACT_CANDIDATE
}

/// How a match attendance punch was recorded (§geofence attendance Phase 1).
enum AttendancePunchSource {
  AUTO
  MANUAL
}

/// On-time vs late classification relative to reporting time.
enum AttendancePunchStatus {
  ON_TIME
  LATE
}

/// Home/away indicator on ACC schedule entries (spec §27).
enum HomeAway {
  HOME
  AWAY
}

/// Toss decision captured per match (spec §11.2).
enum TossDecision {
  BAT
  BOWL
}

/// Registration status lifecycle (spec §7.3).
enum RegistrationStatus {
  IN_WAITLIST
  CONFIRMED
  DECLINED
}

/// Default registration form styles (spec §7.1).
enum BattingStyle {
  RHB
  LHB
}

enum BowlingStyle {
  PACE
  SPIN
}

/// Player role self-reported at registration (§7.1 form).
enum PlayerRegistrationRole {
  BATSMAN
  BOWLER
  ALL_ROUNDER
}

/// Field type of an Admin-built custom registration field (spec §7.2, §21).
enum RegistrationFieldType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

/// Lifecycle of an organizer's request to Admin for a custom form (spec §7.2).
enum CustomFormRequestStatus {
  PENDING
  FULFILLED
  DECLINED
}

/// ACC player category (spec §9.2). Scoped to an ACC team membership.
enum PlayerCategory {
  FULLTIME
  PARTTIME
}

/// Leather-ball registration: full-time vs part-time (informational only).
enum RegistrationPlayerType {
  FULL_TIME
  PART_TIME
}

/// Suspension lifecycle (spec §10.2–§10.5).
enum SuspensionStatus {
  PENDING
  SERVED
  CARRIED_FORWARD
  CANCELLED
}

/// Late-arrival penalty lifecycle (§10 Phase 2). At most one OWED/ASSIGNED per player.
enum LateArrivalPenaltyState {
  OWED
  ASSIGNED
  DISCHARGED
  CANCELLED
}

/// Per-player fee status (spec §20).
enum FeeStatus {
  PENDING
  PAID
}

/// Innings kind — a chained Super Over (spec §14) produces extra innings.
enum InningsType {
  NORMAL
  SUPER_OVER
}

/// Type of a scoring event. A single append-only stream carries both deliveries
/// and discrete non-ball events (spec §12.1). `overNumber`/`ballNumber` are null
/// for non-ball events such as penalty runs or an Impact Player coming in.
enum DeliveryType {
  LEGAL
  WIDE
  NO_BALL
  BYE
  LEG_BYE
  PENALTY_RUNS
  RETIRED_HURT
  RETIRED_OUT
  IMPACT_PLAYER_IN
  MANKAD
  END_INNINGS
  CATCH_DROP
}

/// Dismissal modes in scope (spec §12.1; §30.3 exclusions omitted).
enum DismissalType {
  BOWLED
  CAUGHT
  LBW
  RUN_OUT
  STUMPED
  HIT_WICKET
  RETIRED_OUT
}

// ---------------------------------------------------------------------------
// Core identity & membership
// ---------------------------------------------------------------------------

/// A Province contains many city-level Centers (clubs).
model Province {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  centers Center[]

  tournaments Tournament[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A geographic Center (city-level club) players belong to (spec §3.1 signup field `centerId`).
model Center {
  id         String   @id @default(uuid())
  name       String
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])
  isActive   Boolean  @default(true)

  users           User[]
  registrations   Registration[]
  tournamentLinks TournamentCenter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
}

/// Platform user with the §3.1 signup fields.
///
/// `tokenVersion` powers single-device enforcement (§3.2): every login
/// increments it and embeds the new value in issued JWTs, so any token minted
/// for a prior session fails the guard's version check.
///
/// `role` holds the platform-global base role (PLAYER by default; ADMIN /
/// CLUB_MANAGER set here). Tournament/team/center-scoped roles live in
/// `RoleAssignment` (§2).
model User {
  id                     String    @id @default(uuid())
  firstName              String
  lastName               String
  /// Login identifier; unique across the platform (§3.1).
  mobileNumber           String    @unique
  email                  String
  /// Stored in UTC; the 18+ rule is derived from this (§3.1).
  dateOfBirth            DateTime
  /// Optional street address (product extension; not in spec §3.1).
  address                String?
  /// Optional Canadian postal code (A1A 1A1), normalized on save.
  postalCode             String?
  centerId               String
  center                 Center    @relation(fields: [centerId], references: [id])
  jerseyNumber           Int
  /// Display name on jersey (e.g. "Casablancas"); separate from jerseyNumber.
  jerseyName             String?
  jerseySize             JerseySize?
  /// Sensitive health data — not logged; exposed only to the user and permitted roles.
  hasHealthCard          Boolean   @default(false)
  profilePhotoUrl        String?
  emergencyContactName   String
  emergencyContactNumber String
  passwordHash           String
  /// When true, the user must set a new password before any other app access.
  mustChangePassword     Boolean   @default(false)
  /// UTC expiry for an admin-issued temporary password; null when not applicable.
  tempPasswordExpiresAt  DateTime?
  role                   UserRole  @default(PLAYER)
  tokenVersion           Int       @default(0)
  isActive               Boolean   @default(true)
  /// Set when the account is locked from password reset after too many failed
  /// OTP entries (§3.4). Cleared by an admin/captain/club-manager unlock.
  passwordResetLockedAt  DateTime?
  /// Soft-delete — excluded from directory and selectable lists; history retained.
  deletedAt              DateTime?

  roleAssignments RoleAssignment[]
  memberships     TeamMembership[]
  registrations   Registration[]
  suspensions     Suspension[]
  lateArrivalPenalties LateArrivalPenalty[]
  lateArrivalPenaltiesCancelled LateArrivalPenalty[] @relation("PenaltyCancelledBy")
  lateArrivalPenaltyTransitions LateArrivalPenaltyTransition[]
  pollVotes       PollVote[]
  skillVideos      PlayerSkillVideo[]
  fees            Fee[]
  squadEntries    MatchSquadPlayer[]
  finalizedSquads MatchSquad[] @relation("MatchSquadFinalizedBy")
  attendancePunches MatchAttendancePunch[]
  attendancePunchesSet MatchAttendancePunch[] @relation("AttendancePunchSetBy")
  teamRegistrationFavourites TeamRegistrationFavourite[] @relation("TeamRegistrationFavourites")
  leatherInvitesSent         TournamentLeatherInvite[] @relation("LeatherInvitesSent")
  leatherInvitesReceived     TournamentLeatherInvite[] @relation("LeatherInvitesReceived")
  tournamentScorerAssignments TournamentScorer[]
  broadcastsPosted           Broadcast[]
  pushDeviceTokens           PushDeviceToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
  @@index([deletedAt])
}

/// Shared tennis tournament scorer pool (Phase 1) — exactly five registered players per tournament.
model TournamentScorer {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  assignedById String
  assignedAt   DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

/// A scoped role grant (spec §2). Examples:
/// - Center Sevak → `centerId` set.
/// - Captain / Vice Captain / Manager → `teamId` + `tournamentId` set.
/// Platform-global ADMIN / CLUB_MANAGER are represented on `User.role`, not here.
model RoleAssignment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  role         UserRole
  /// Scope (any/all may be null depending on the role).
  centerId     String?
  tournamentId String?
  teamId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role, tournamentId, teamId, centerId])
  @@index([tournamentId])
  @@index([teamId])
  @@index([centerId])
}

// ---------------------------------------------------------------------------
// Tournament structure
// ---------------------------------------------------------------------------

/// A tournament instance. Type/state/format and the §6.1 Add-Tournament fields.
model Tournament {
  id                  String           @id @default(uuid())
  name                String
  year                Int
  posterUrl           String?
  /// Set at match setup (overs vary per match, e.g. a shorter final). Required for the
  /// scoring engine (run rate, projected score, chase equation, innings length).
  /// TODO(match-setup): collect on each match, not at tournament create.
  oversPerInnings     Int?
  maxOversPerBowler   Int
  locationAddress     String?
  latitude            Float?
  longitude           Float?
  /// IANA timezone for venue-local display and schedule rules (§23).
  timezone            String?
  /// All datetimes UTC (§23).
  startAt             DateTime
  endAt               DateTime
  registrationOpenAt  DateTime?
  registrationCloseAt DateTime?
  auctionAt           DateTime?
  /// Province the tournament belongs to (categorization; independent of venue location).
  provinceId          String?
  province            Province?        @relation(fields: [provinceId], references: [id])
  /// Expected team count for fixture/setup (§6.1).
  numberOfTeams       Int              @default(4)
  /// APL only — even number of teams in the knockout phase; null until configured.
  knockoutTeamCount   Int?
  /// Set when the knockout final is confirmed.
  championTeamId      String?
  championTeam        Team?            @relation("TournamentChampion", fields: [championTeamId], references: [id])
  /// Squad size per team; Playing XI remains 11 (§9.7). Null = no roster cap.
  playersPerTeam      Int?
  /// Substitutes allowed per match squad (§9.7; default 2).
  substitutesAllowed  Int              @default(2)
  ballType            BallType
  type                TournamentType
  state               TournamentState  @default(NEW)
  format              TournamentFormat
  /// Chosen when the organizer schedules fixtures (Schedule Matches modal).
  matchSchedulingFormat MatchSchedulingFormat?
  impactPlayerEnabled Boolean          @default(false)
  videoRequired       Boolean          @default(false)
  /// Skill-video upload window opens (tennis, when videoRequired).
  videoUploadStartAt  DateTime?
  /// Skill-video upload window closes; notification fires ~10 min before (§19).
  videoUploadEndDate  DateTime?
  /// Optional tournament-level stream; per-match URLs live on Match (§22).
  youtubeUrl          String?
  /// Default per-player tournament fee in cents (§20). Overridable per registration.
  defaultPlayerFeeCents BigInt?
  /// Tennis: single tournament fee; Leather: full-time player fee (CAD dollars).
  feeFullTime           Decimal? @db.Decimal(10, 2)
  /// Leather part-time player fee (CAD dollars); null for tennis tournaments.
  feePartTime           Decimal? @db.Decimal(10, 2)
  /// Platform-global organizer (Club Manager / Center Sevak); not a hard FK.
  createdByUserId     String

  /// Soft-delete — row and relations are retained for audit / future restore.
  isDeleted           Boolean          @default(false)
  deletedAt           DateTime?
  deletedById         String?

  teams              Team[]
  groups             TournamentGroup[]
  centerLinks        TournamentCenter[]
  scheduledDates     TournamentDate[]
  registrations      Registration[]
  registrationFields RegistrationFieldDefinition[]
  customFormRequests CustomFormRequest[]
  matches            Match[]
  memberships        TeamMembership[]
  suspensions        Suspension[]
  lateArrivalPenalties LateArrivalPenalty[]
  skillVideos        PlayerSkillVideo[]
  fees               Fee[]
  teamRegistrationFavourites TeamRegistrationFavourite[]
  leatherInvites           TournamentLeatherInvite[]
  tournamentScorers        TournamentScorer[]
  knockoutBracket          KnockoutBracket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([state])
  @@index([isDeleted])
  @@index([provinceId])
}

/// Metadata row for a generated APL knockout bracket (one per tournament).
model KnockoutBracket {
  id                String     @id @default(uuid())
  tournamentId      String     @unique
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracketSize       Int
  byeCount          Int
  knockoutTeamCount Int
  createdAt         DateTime   @default(now())
  matches           Match[]

  @@index([tournamentId])
}

/// Calendar days on which matches may be scheduled for a tournament (source of truth).
/// `Tournament.startAt` / `endAt` are derived from min/max of these rows.
/// TODO(match-scheduling): fixture creation must only allow dates present here.
model TournamentDate {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// UTC midnight for the calendar day (§23).
  date         DateTime

  @@unique([tournamentId, date])
  @@index([tournamentId])
}

/// Path B: Club Manager / Admin invite for leather tournaments before start date.
model TournamentLeatherInvite {
  id              String     @id @default(uuid())
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation("LeatherInvitesReceived", fields: [userId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedBy       User       @relation("LeatherInvitesSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  invitedAt       DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

/// Which Centers (cities) participate — drives the §1.1 type-resolution logic
/// (APL = all cities; Center-level = a subset).
model TournamentCenter {
  tournamentId String
  centerId     String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  center       Center     @relation(fields: [centerId], references: [id])

  @@id([tournamentId, centerId])
  @@index([centerId])
}

/// A team scoped to a single tournament (spec §6.3). Display-name overlap with
/// past tournaments is allowed; each tournament gets its own team rows, so the
/// uniqueness is only within a tournament.
model Team {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  name         String
  /// Lowercase trimmed `name` — enforces case-insensitive uniqueness per tournament.
  nameNormalized String
  logoUrl      String?
  groupId      String?
  group        TournamentGroup? @relation(fields: [groupId], references: [id])

  memberships TeamMembership[]
  homeMatches Match[]          @relation("HomeTeam")
  awayMatches Match[]          @relation("AwayTeam")
  matchSquads MatchSquad[]
  fees        Fee[]
  polls       AvailabilityPoll[]
  attendancePunches MatchAttendancePunch[]
  lateArrivalPenalties LateArrivalPenalty[]
  teamRegistrationFavourites TeamRegistrationFavourite[]

  /// Soft-delete — row retained; excluded from schedules and team lists.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  championOfTournaments Tournament[] @relation("TournamentChampion")

  @@unique([tournamentId, nameNormalized])
  @@index([tournamentId])
  @@index([tournamentId, deletedAt])
  @@index([groupId])
}

/// A group within a tournament (Group Stage + Knockout scheduling).
model TournamentGroup {
  id             String     @id @default(uuid())
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id])
  name           String
  nameNormalized String
  teams          Team[]
  matches        Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, nameNormalized])
  @@index([tournamentId])
}

/// A player's team assignment within a tournament. The `(tournamentId, userId)`
/// unique enforces "one player belongs to exactly one team per tournament"
/// (§26), while allowing the same player on different teams across simultaneous
/// tournaments.
model TeamMembership {
  id             String          @id @default(uuid())
  tournamentId   String
  tournament     Tournament      @relation(fields: [tournamentId], references: [id])
  teamId         String
  team           Team            @relation(fields: [teamId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  /// ACC only (§9.2); null for APL / Center-level.
  playerCategory PlayerCategory?

  /// Soft-delete — preserves historical roster attribution and permits later reactivation.
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  deletedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, userId])
  @@index([teamId])
  @@index([teamId, isDeleted])
  @@index([tournamentId, isDeleted])
}

/// A player's registration into a tournament with the §7.3 status lifecycle.
/// Default §7.1 fields are columns; `customFields` holds any §7.2/§21 custom
/// form data. Ratings are per-tournament (Center Sevak updates them — §7.5).
model Registration {
  id           String             @id @default(uuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  centerId     String
  center       Center             @relation(fields: [centerId], references: [id])
  status       RegistrationStatus @default(IN_WAITLIST)

  battingStyle     BattingStyle?
  /// Self-reported at registration; Center Sevak may overwrite after window closes (§7.5).
  battingRating    Int?
  battingPosition  String?
  playerRole       PlayerRegistrationRole?
  bowlingStyle     BowlingStyle?
  bowlingType      String?
  bowlingRating    Int?
  fieldingRating   Int?
  fieldingPosition String?
  /// Leather-ball only — full-time vs part-time (§7.1); null for tennis.
  playerType       RegistrationPlayerType?
  /// APL availability for tournament dates, recorded by Center Sevak (§7.5).
  /// Null = not yet contacted; true/false = available / unavailable.
  isAvailable      Boolean?
  availabilityNote String?
  /// Additional/modified fields from a tournament-specific custom form (§7.2).
  customFields     Json?
  /// Per-player fee owed for this tournament in cents (§20). Falls back to tournament default.
  feeAmountCents   BigInt?

  /// Center Sevak who approved/declined (§7.3); not a hard FK.
  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fees Fee[]

  @@unique([tournamentId, userId])
  @@index([centerId])
  @@index([status])
}

/// Per-team shared shortlist of verified registrants (Captain + Vice-Captain + Manager).
model TeamRegistrationFavourite {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("TeamRegistrationFavourites", fields: [userId], references: [id])
  /// Captain / VC / Manager who last toggled the heart (audit only).
  favouritedByUserId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, teamId, userId])
  @@index([tournamentId, teamId])
}

/// An Admin-built custom registration field, scoped to one tournament (§7.2,
/// §21). Other tournaments are unaffected. The player's answer is stored under
/// `Registration.customFields[key]`.
model RegistrationFieldDefinition {
  id           String                @id @default(uuid())
  tournamentId String
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Machine key used in `Registration.customFields`.
  key          String
  label        String
  fieldType    RegistrationFieldType  @default(TEXT)
  required     Boolean                @default(false)
  /// Choices for a SELECT field (array of strings).
  options      Json?
  /// Display order on the form.
  position     Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, key])
  @@index([tournamentId])
}

/// An organizer's (Club Manager / Center Sevak) request to Admin to add or
/// modify registration fields for a specific tournament (§7.2). Admin fulfils
/// it by building the `RegistrationFieldDefinition` rows.
model CustomFormRequest {
  id                String                  @id @default(uuid())
  tournamentId      String
  tournament        Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Requesting organizer; not a hard FK.
  requestedByUserId String
  note              String?
  /// Proposed field specs (array of { key, label, fieldType, required, options }).
  requestedFields   Json?
  status            CustomFormRequestStatus @default(PENDING)
  resolvedByUserId  String?
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Matches, scoring & results
// ---------------------------------------------------------------------------

/// A match. For APL / Center-level both sides are system Teams. For ACC the
/// home side is one of the four fixed teams and the opponent is external
/// (`externalOpponentName`, no system Team — §9.5). `matchCode` is the
/// organizer/captain-entered "Match ID" from the schedule (§27), distinct from
/// the database `id`.
model Match {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  matchCode    String?
  state        MatchState @default(SCHEDULED)
  matchType    MatchType  @default(LEAGUE_MATCH)

  homeTeamId           String?
  homeTeam             Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId           String?
  awayTeam             Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  /// ACC opponent — free text, no external registry maintained (§9.5).
  externalOpponentName String?

  /// ACC schedule inputs (§27). All datetimes UTC (§23).
  groupId            String?
  group              TournamentGroup? @relation(fields: [groupId], references: [id])
  /// Per-match innings length — required at match setup (§6.1 deferred from tournament create).
  oversPerInnings    Int?
  maxOversPerBowler  Int?
  /// Fielding-restriction phase length (match-level; §31 #2). Nullable = none configured.
  powerplayOvers         Int?
  /// Tennis-ball batting powerplay phase (match-level). Null for leather / unset.
  battingPowerplayOvers  Int?
  division       String?
  homeAway       HomeAway?
  groundLocation String?
  geofenceLat    Float?
  geofenceLng    Float?
  matchDate      DateTime?
  startTime      DateTime?
  /// Cumulative pre-live delay (minutes). Original `startTime` is never overwritten.
  delayMinutes   Int       @default(0)
  reportingTime  DateTime?

  /// Toss data (§11.2) — the animated flip is out of scope but the data isn't.
  tossWinner   MatchSide?
  tossDecision TossDecision?

  /// Opening players recorded at match start before the first ball (§11).
  openingStrikerUserId    String?
  openingNonStrikerUserId String?
  openingBowlerUserId     String?

  /// Per-match stream URL (§22).
  youtubeUrl String?

  /// Original and DLS-revised targets shown together on the scorecard (§12.1).
  originalTarget Int?
  dlsTarget      Int?

  /// Optimistic-concurrency token for scorecard writes (§12.3). Every accepted
  /// scoring mutation bumps this; a stale save is rejected with
  /// "Scorecard got updated."
  scorecardVersion Int @default(0)

  /// Result/outcome (an explicit decision, not a derived stat).
  isNoResult          Boolean @default(false)
  winningTeamId       String?
  manOfTheMatchUserId String?
  /// Winning captain's MoM selection timestamp (UTC — §13.3).
  manOfTheMatchSelectedAt       DateTime?
  /// User who confirmed MoM (winning Captain or acting VC — §13.3).
  manOfTheMatchSelectedByUserId String?
  resultNote          String?

  /// Scorecard confirmation (§13.1). `completedAt` starts the 5-hour window
  /// (measured in UTC — §23). `confirmedByUserId` is null when the System
  /// auto-confirms; `autoConfirmed` records that path for the audit trail.
  completedAt       DateTime?
  confirmedAt       DateTime?
  confirmedByUserId String?
  autoConfirmed     Boolean   @default(false)
  /// Two-sided confirmation — home side (team A) and away side (team B).
  homeTeamConfirmed         Boolean   @default(false)
  homeTeamConfirmedByUserId String?
  homeTeamConfirmedAt       DateTime?
  awayTeamConfirmed         Boolean   @default(false)
  awayTeamConfirmedByUserId String?
  awayTeamConfirmedAt       DateTime?
  /// Admin / Club Manager override — finalizes both sides outright.
  adminConfirmed         Boolean   @default(false)
  adminConfirmedByUserId String?
  adminConfirmedAt       DateTime?

  /// Soft-delete — row kept; excluded from schedules and round-robin pair guard when true.
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  deletedById         String?
  /// Sorted `teamId:teamId` for round-robin duplicate guard; null for non-RR / external fixtures.
  roundRobinPairKey   String?

  /// Knockout bracket placement and advancement (GROUP_STAGE_KNOCKOUT).
  bracketId          String?
  bracket            KnockoutBracket? @relation(fields: [bracketId], references: [id], onDelete: SetNull)
  awaitingTeams      Boolean        @default(false)
  bracketRoundIndex  Int?
  bracketPosition    Int?
  bracketRoundLabel  String?
  nextMatchId        String?
  nextMatch          Match?     @relation("KnockoutAdvancement", fields: [nextMatchId], references: [id])
  nextMatchSlot      MatchSide?
  feedsIntoMatches   Match[]    @relation("KnockoutAdvancement")

  innings         Innings[]
  scorerGrants    MatchScorerGrant[]
  externalPlayers ExternalPlayer[]
  squads          MatchSquad[]
  poll            AvailabilityPoll[]
  attendancePunches MatchAttendancePunch[]
  penaltiesOriginated LateArrivalPenalty[] @relation("PenaltyOriginMatch")
  penaltiesServing    LateArrivalPenalty[] @relation("PenaltyServeMatch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([state])
  @@index([isDeleted])
  @@index([tournamentId, roundRobinPairKey])
  @@index([tournamentId, bracketRoundIndex])
  @@index([bracketId])
  @@index([nextMatchId])
}

/// Per-match Scorer grant (§2, §11.1). A Player is granted scoring for one
/// match; auto-revoked at match completion (System, via `revokedAt`) or revoked
/// on handover by Captain/VC. An active grant (`revokedAt IS NULL`) satisfies
/// the SCORER subject in the permission matrix. History is retained — handovers
/// create new rows.
model MatchScorerGrant {
  id              String    @id @default(uuid())
  matchId         String
  match           Match     @relation(fields: [matchId], references: [id])
  /// The granted player (platform-global ref; not a hard FK to keep grants
  /// decoupled from user deletion semantics).
  userId          String
  grantedByUserId String?
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([matchId])
  @@index([userId])
}

/// A team's locked matchday squad for a match (spec §5.2, §9.7). One row per
/// participating system team; locking it moves the match toward
/// "Playing 11 Locked". For ACC only the single system side has a squad (the
/// opponent is external — §9.5).
model MatchSquad {
  id             String   @id @default(uuid())
  matchId        String
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  /// Captain / VC who posted the 11 (or Club Manager fallback — §31 #1).
  lockedByUserId String
  lockedAt       DateTime @default(now())
  /// Pre-match confirmation gate — editable after finalize until the match goes Live.
  isFinalized        Boolean   @default(false)
  finalizedByUserId  String?
  finalizedBy        User?     @relation("MatchSquadFinalizedBy", fields: [finalizedByUserId], references: [id])
  finalizedAt        DateTime?

  players MatchSquadPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, teamId])
  @@index([teamId])
}

/// One player in a locked squad. `isActiveImpact` marks the chosen active 12th
/// among up to three IMPACT_CANDIDATE rows (§31 #4(a) — pick at lock time).
model MatchSquadPlayer {
  id             String         @id @default(uuid())
  squadId        String
  squad          MatchSquad     @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  role           MatchSquadRole
  isActiveImpact Boolean        @default(false)
  /// Optional batting-order hint captured at selection.
  battingOrder   Int?

  @@unique([squadId, userId])
  @@index([userId])
}

/// One attendance punch per player per match (§geofence attendance Phase 1).
/// Absence is represented by no row (NOT_ARRIVED is computed at read time).
model MatchAttendancePunch {
  id           String                @id @default(uuid())
  matchId      String
  match        Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id])
  teamId       String
  team         Team                  @relation(fields: [teamId], references: [id])
  punchTimeUtc DateTime
  source       AttendancePunchSource
  status       AttendancePunchStatus
  /// Captain verified a late punch (Phase 2 penalty input).
  verifiedLate Boolean               @default(false)
  /// Captain verified on-time penalty serve completion at the serving match.
  verifiedServeCompletion Boolean      @default(false)
  /// Captain who manual-entered or edited; null for auto punch.
  setByUserId  String?
  setBy        User?                 @relation("AttendancePunchSetBy", fields: [setByUserId], references: [id])
  editedFlag   Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([matchId, teamId])
}

/// External (non-system) opponent players for an ACC match. Names may start as
/// placeholders "Player 1".."Player 11" and be updated live (§9.5). Deliveries
/// reference these by `externalPlayerId` instead of a `userId`.
model ExternalPlayer {
  id           String         @id @default(uuid())
  matchId      String
  match        Match          @relation(fields: [matchId], references: [id])
  slot         Int
  name         String
  battingStyle BattingStyle?
  bowlingType  String?

  @@unique([matchId, slot])
}

/// One innings of a match. A chained Super Over (§14) adds further innings with
/// `inningsType = SUPER_OVER` and an incrementing `sequence`. The batting/
/// bowling side may be external in ACC, so team refs are nullable scalars with
/// `*IsExternal` flags. Totals/wickets are NOT stored — derived from deliveries
/// at query time (conventions).
model Innings {
  id                String      @id @default(uuid())
  matchId           String
  match             Match       @relation(fields: [matchId], references: [id])
  sequence          Int
  inningsType       InningsType @default(NORMAL)
  battingTeamId     String?
  bowlingTeamId     String?
  battingIsExternal Boolean     @default(false)
  bowlingIsExternal Boolean     @default(false)
  /// Overs allotted may be revised after a rain interruption (§12.2).
  oversAllotted     Int?
  revisedTarget     Int?
  /// Scorer-selected at-crease batters and current-over bowler before they appear on a delivery.
  selectedStrikerUserId      String?
  selectedStrikerExternalId  String?
  selectedNonStrikerUserId   String?
  selectedNonStrikerExternalId String?
  selectedBowlerUserId       String?
  selectedBowlerExternalId   String?

  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, sequence])
}

/// Append-only ball-by-ball / scoring event (Phase 3; spec §12.1).
///
/// Append-only: balls are never updated or deleted. A correction within the
/// edit window (§12.2) inserts a NEW row and marks the prior row
/// `isVoided = true` with `supersededByDeliveryId` pointing at the replacement;
/// the live scorecard is the set of non-voided rows. `revision` increments
/// across a correction chain. Participants may be system users (`*UserId`) or
/// external players (`*ExternalId`) per §9.5.
model Delivery {
  id         String       @id @default(uuid())
  inningsId  String
  innings    Innings      @relation(fields: [inningsId], references: [id])
  type       DeliveryType
  /// Monotonically increasing append order within the innings (§12.1). Never
  /// reused; corrections append a new row with a higher sequence.
  sequence   Int
  /// Over (1-indexed) and the delivery's index within the over INCLUDING
  /// illegal balls (so wides/no-balls keep a stable position). Null only for
  /// non-ball events (penalty runs, retirements, Impact Player in).
  overNumber Int?
  ballNumber Int?

  strikerUserId        String?
  strikerExternalId    String?
  nonStrikerUserId     String?
  nonStrikerExternalId String?
  bowlerUserId         String?
  bowlerExternalId     String?

  /// Runs off the bat (boundaries + running + overthrows on the same ball).
  runsBat   Int     @default(0)
  /// Wide / no-ball / bye / leg-bye / penalty runs credited to the batting team.
  extraRuns Int     @default(0)
  /// On a no-ball: completed runs as byes (penalty stays in extraRuns).
  noBallByeRuns    Int @default(0)
  /// On a no-ball: completed runs as leg-byes (penalty stays in extraRuns).
  noBallLegByeRuns Int @default(0)
  /// Penalty-runs only: opaque team id receiving the runs (defaults to batting side).
  penaltyBeneficiaryTeamId String?
  /// True for a 4/6 off the bat. Boundaries never rotate strike (§32), so this
  /// is required to derive rotation correctly when overthrows inflate runsBat.
  isBoundary Boolean @default(false)
  /// Set after any no-ball; the next legal delivery is a free hit (§12.1).
  isFreeHit Boolean @default(false)

  /// Dismissal, including combinations (wide+stumping, no-ball+run-out — §12.1).
  dismissalType       DismissalType?
  dismissedUserId     String?
  dismissedExternalId String?
  fielderUserId       String?
  fielderExternalId   String?
  /// Relay run-out — second fielder (notation "run out (f1/f2)").
  fielder2UserId      String?
  fielder2ExternalId  String?

  /// Append-only correction tracking.
  revision               Int       @default(1)
  isVoided               Boolean   @default(false)
  supersededByDeliveryId String?   @unique
  supersededBy           Delivery? @relation("DeliveryCorrection", fields: [supersededByDeliveryId], references: [id])
  supersedes             Delivery? @relation("DeliveryCorrection")

  /// Who recorded the event (the active Scorer); not a hard FK.
  createdByUserId String

  createdAt DateTime @default(now())

  @@index([inningsId])
  @@index([inningsId, sequence])
  @@index([inningsId, overNumber, ballNumber])
}

// ---------------------------------------------------------------------------
// Geofence suspension, polls, fees, videos (ACC + tournament features)
// ---------------------------------------------------------------------------

/// A geofence-driven 1-match suspension (§10). Triggered by late arrival at
/// `triggeredByMatchId`, served at `servingMatchId`; may extend or carry forward
/// per §10.3. Cancellation is captain-driven and audited (§10.5). Cross-
/// tournament carry-over is out of scope (§26), so it is scoped to one
/// tournament.
model Suspension {
  id                 String           @id @default(uuid())
  tournamentId       String
  tournament         Tournament       @relation(fields: [tournamentId], references: [id])
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  teamId             String?
  status             SuspensionStatus @default(PENDING)
  /// The match whose late arrival triggered it, and where it is to be served.
  triggeredByMatchId String?
  servingMatchId     String?
  reason             String?
  /// Match where the captain carry-forward / cancel action was taken (IN-tab badge).
  actionedAtMatchId  String?
  /// Times this offense was carried forward (captain or auto while serving).
  carryForwardCount  Int              @default(0)
  cancelledByUserId  String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tournamentId])
  @@index([status])
  @@index([servingMatchId, teamId, status])
  @@index([actionedAtMatchId])
}

/// Late-arrival penalty (§10 Phase 2). One active (OWED/ASSIGNED) per player at most.
model LateArrivalPenalty {
  id                   String                  @id @default(uuid())
  playerId             String
  player               User                    @relation(fields: [playerId], references: [id])
  teamId               String
  team                 Team                    @relation(fields: [teamId], references: [id])
  tournamentId         String
  tournament           Tournament              @relation(fields: [tournamentId], references: [id])
  /// Match where the captain verified the late arrival that created this penalty.
  originMatchId        String
  originMatch          Match                   @relation("PenaltyOriginMatch", fields: [originMatchId], references: [id])
  state                LateArrivalPenaltyState
  assignedServeMatchId String?
  assignedServeMatch   Match?                  @relation("PenaltyServeMatch", fields: [assignedServeMatchId], references: [id])
  dischargedAt         DateTime?
  cancelledByUserId    String?
  cancelledBy          User?                   @relation("PenaltyCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelledAt          DateTime?

  transitions LateArrivalPenaltyTransition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
  @@index([teamId])
  @@index([tournamentId])
  @@index([state])
  @@index([assignedServeMatchId])
}

/// Append-only state transition log for a late-arrival penalty.
model LateArrivalPenaltyTransition {
  id             String                   @id @default(uuid())
  penaltyId      String
  penalty        LateArrivalPenalty       @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  fromState      LateArrivalPenaltyState?
  toState        LateArrivalPenaltyState
  actorUserId    String?
  actor          User?                    @relation(fields: [actorUserId], references: [id])
  reason         String?
  contextMatchId String?

  createdAt DateTime @default(now())

  @@index([penaltyId])
}

/// Per-team availability poll for a leather-ball match (§9.7). One poll per
/// participating system team — ACC vs ACC has two independent polls.
model AvailabilityPoll {
  id       String   @id @default(uuid())
  matchId  String
  match    Match    @relation(fields: [matchId], references: [id])
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id])
  opensAt  DateTime
  /// Auto-close at 5 PM ground-local, two calendar days before match date.
  closesAt DateTime

  votes PollVote[]

  createdAt DateTime @default(now())

  @@unique([matchId, teamId])
  @@index([teamId])
}

/// A player's Yes/No availability vote (§9.7).
model PollVote {
  id          String           @id @default(uuid())
  pollId      String
  poll        AvailabilityPoll @relation(fields: [pollId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  isAvailable Boolean
  votedAt     DateTime         @default(now())

  @@unique([pollId, userId])
}

/// Player skill video for scouting / auction (§19). One per player per tournament.
model PlayerSkillVideo {
  id              String                 @id @default(uuid())
  tournamentId    String
  tournament      Tournament             @relation(fields: [tournamentId], references: [id])
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  /// Playback URL returned by the active storage provider.
  url             String
  mimeType        String
  sizeBytes       Int
  storageKey      String
  status          PlayerSkillVideoStatus @default(READY)
  durationSeconds Int?
  uploadedAt      DateTime               @default(now())

  @@unique([tournamentId, userId])
  @@map("PlayerSkillVideo")
}

enum PlayerSkillVideoStatus {
  READY
}

/// Manual fee record per player per tournament (§20). No payment gateway;
/// amounts in cents (BIGINT), never floats (conventions).
model Fee {
  id               String     @id @default(uuid())
  tournamentId     String
  tournament       Tournament @relation(fields: [tournamentId], references: [id])
  registrationId   String?
  registration     Registration? @relation(fields: [registrationId], references: [id])
  teamId           String?
  team             Team?      @relation(fields: [teamId], references: [id])
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  amountCents      BigInt
  status           FeeStatus  @default(PENDING)
  paidAt           DateTime?
  /// Club Manager who recorded the payment; not a hard FK.
  recordedByUserId String?
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, userId])
  @@index([teamId])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Broadcast messages (admin → all dashboards, 24h TTL)
// ---------------------------------------------------------------------------

model Broadcast {
  id        String    @id @default(uuid())
  imageUrl  String?
  text      String?
  postedBy  String
  poster    User      @relation(fields: [postedBy], references: [id])
  postedAt  DateTime  @default(now())
  expiresAt DateTime
  removedAt DateTime?

  @@index([postedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// App settings (admin-configurable runtime values)
// ---------------------------------------------------------------------------

/// Key-value app settings (upload limits, etc.). Values are JSON for forward compatibility.
model AppSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Push notifications (§17) — device tokens + de-dupable send log
// ---------------------------------------------------------------------------

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

/// FCM device registration token per user device. A user may have many (one per
/// device/install). Pruned when FCM reports the token is no longer valid.
model PushDeviceToken {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FCM registration token; unique across the platform (a token maps to one device).
  token      String       @unique
  platform   PushPlatform
  /// Bumped whenever the client re-registers the same token (liveness signal).
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
}

/// One record per logical notification send (§17). `dedupeKey` makes timed jobs
/// and retries idempotent: a unique key that already exists short-circuits the
/// send. Kept indefinitely (no auto-purge).
model NotificationLog {
  id             String   @id @default(uuid())
  /// Semantic trigger key (e.g. "MATCH_REMINDER"); free-form for forward compat.
  triggerKey     String
  /// Idempotency key for the logical notification (e.g. "MATCH_REMINDER:matchX:2026-07-07").
  /// Null for ad-hoc sends that intentionally allow duplicates.
  dedupeKey      String?  @unique
  title          String
  body           String
  /// Structured FCM `data` payload as sent.
  data           Json?
  /// Number of recipient users resolved for this send.
  recipientCount Int
  /// Number of device tokens FCM accepted.
  successCount   Int      @default(0)
  /// Number of device tokens FCM rejected (and pruned).
  failureCount   Int      @default(0)
  /// Human-readable audience description for traceability (e.g. "APL tournament X centers").
  audienceSummary String?
  sentAt         DateTime @default(now())

  @@index([triggerKey])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// Audit log (§18)
// ---------------------------------------------------------------------------

/// Immutable audit trail (§18). Entries are append-only and viewable by Admin
/// only (enforced in the app layer). Format per §18.2: timestamp (UTC), actor,
/// action type, target entity, and a before/after snapshot for data mutations.
model AuditLog {
  id               String   @id @default(uuid())
  /// Action type, e.g. "PASSWORD_RESET_UNLOCK", "SCORECARD_EDIT".
  action           String
  /// Acting user; null when the actor is the System internal actor (§2),
  /// in which case `actorLabel` = "System".
  actorUserId      String?
  actorLabel       String?
  /// Convenience pointer when the target is a user (kept for existing callers).
  targetUserId     String?
  /// Generic target entity (e.g. "match", "scorecard", "player").
  targetEntityType String?
  targetEntityId   String?
  /// State snapshots for data-mutation events (§18.2).
  before           Json?
  after            Json?
  /// Free-form structured context.
  details          Json?
  createdAt        DateTime @default(now())

  @@index([targetUserId])
  @@index([targetEntityType, targetEntityId])
  @@index([action])
}
