{
  "expo": {
    "name": "ASC",
    "slug": "acc",
    "scheme": "acc",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/acc_icon_1024.png",
    "splash": {
      "image": "./assets/acc_logo_master.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2044"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atmiya.acc",
      "appleTeamId": "YUZ2DTL3T9",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyBhBCpky5whHbOUxGC2-kJM8KlBJno7y2I"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "location"
        ],
        "NSPhotoLibraryUsageDescription": "Allow ASC to access your photos so you can upload a profile picture, tournament posters, and videos.",
        "NSLocalNetworkUsageDescription": "ASC connects to the development API on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atmiya.acc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/acc_adaptive_foreground.png",
        "backgroundColor": "#1A2044"
      },
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBhBCpky5whHbOUxGC2-kJM8KlBJno7y2I"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withIosScriptSandboxDisabled.js",
      "./plugins/withDateTimePickerNewArchFix.js",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ASC to access your photos so you can upload a profile picture, tournament posters, and videos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ASC uses your location to confirm you arrived at the ground for a match.",
          "locationAlwaysAndWhenInUsePermission": "ASC uses your location in the background to mark match attendance via a geofence around the ground.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/acc_favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc9f175d-c8fa-460d-b0e8-f2ca1b48855a"
      }
    }
  }
}
