# Copy to .env: cp .env.example .env  (.env is git-ignored)
#
# Base URL of the ACC api. Variables prefixed with EXPO_PUBLIC_ are inlined into
# the app at build time.
#
# - iOS simulator / web on the same machine: http://localhost:3001
# - Physical phone via Expo Go: use your computer's LAN IP on port 3001 (the api),
#   NOT Expo's Metro port (often 8081/8082). Example:
#     EXPO_PUBLIC_API_URL=http://192.168.1.50:3001
#   (the phone cannot reach "localhost" — that points at the phone itself)
#
# Verify from your phone's network: curl http://<your-lan-ip>:3001/health
# The API must be running: pnpm dev:api (from repo root)
EXPO_PUBLIC_API_URL=http://192.168.2.11:3001