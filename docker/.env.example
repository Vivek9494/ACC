# Local Postgres + Redis settings consumed by docker/docker-compose.yml.
# Copy to docker/.env and adjust as needed: cp docker/.env.example docker/.env

POSTGRES_USER=acc
POSTGRES_PASSWORD=acc
POSTGRES_DB=acc
# Host ports default to 5435/6380 to avoid clashing with other local
# Postgres/Redis instances already bound to 5432/5433/5434 and 6379 on this
# machine. Set these to 5432/6379 if those ports are free for you.
POSTGRES_PORT=5435

REDIS_PORT=6380

# Convenience connection strings for the api app (.env in apps/api later):
# DATABASE_URL=postgresql://acc:acc@localhost:5435/acc?schema=public
# REDIS_URL=redis://localhost:6380
